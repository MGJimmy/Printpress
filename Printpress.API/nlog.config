<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

	<targets>
	  <target name="frameworkFile" xsi:type="File" fileName="${basedir}/logs/framework.txt"
			  layout="${longdate}|${level}|${logger}|${message} ${exception}" />
	  <target name="appFile" xsi:type="File" fileName="${basedir}/logs/app.txt"
			  layout="${longdate}|${level}|${logger}|${message} ${exception}" />
	</targets>

	<rules>
	  <logger name="Microsoft.*" minlevel="Warn" writeTo="frameworkFile" />
	  <logger name="Printpress.*" minlevel="Info" writeTo="appFile" />
	</rules>

</nlog>
